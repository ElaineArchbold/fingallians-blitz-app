VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# The app talks to Supabase directly from the browser (src/supabaseClient.js),
# so this MUST be the anon/public key, never the service_role key — anything
# in a VITE_-prefixed var gets baked into the JS bundle your browser downloads.
# The kv_store table has RLS enabled with policies granting the anon role
# read/write, scoped to just this table (see migrate_kv_to_supabase.sql).
