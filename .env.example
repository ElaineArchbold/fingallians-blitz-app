SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Use the service_role key here, NOT the anon/public key — the blitz_kv_store
# table has Row Level Security enabled with no policies, so only the
# service_role key (used server-side in api/kv.js) can read/write it.
